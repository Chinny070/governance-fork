{
  "name": "governance-fork-webapp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Production dApp for the Governance Fork Intelligent Contract on GenLayer StudioNet",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:shapes": "node scripts/verify-call-shapes.mjs"
  },
  "dependencies": {
    "genlayer-js": "1.1.8",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.0",
    "vite": "6.0.5",
    "vitest": "2.1.8"
  }
}
